---
import { Icon } from "astro-icon/components";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Demand Forecasting & Purchasing Automation — Alfonso Palma"
    />
    <title>Demand Forecasting & Purchasing Automation — Alfonso Palma</title>
  </head>

  <body>
    <header class="navbar">
      <a href="/" class="logo">AP.</a>
      <a href="/" class="back">← Back to portfolio</a>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">Case Study · Machine Learning & Operations</p>

        <h1>
          Demand Forecasting<br />
          & Purchasing <span>Automation.</span>
        </h1>

        <div class="hero-grid">
          <p class="intro">
            A forecasting workflow designed to transform historical restaurant
            sales into more informed purchasing and inventory decisions.
          </p>

          <div class="meta">
            <div>
              <span>ROLE</span>
              <strong>Analytics & Operations</strong>
            </div>

            <div>
              <span>FOCUS</span>
              <strong>Forecasting · ML · Purchasing</strong>
            </div>

            <div>
              <span>ENVIRONMENT</span>
              <strong>Restaurant operations</strong>
            </div>
          </div>
        </div>
      </section>

      <section class="impact">
        <div class="impact-item">
          <span>01</span>
          <strong>19% WAPE</strong>
          <p>
            Forecasting performance achieved during model evaluation.
          </p>
        </div>

        <div class="impact-item">
          <span>02</span>
          <strong>Multi-model</strong>
          <p>
            Different demand patterns were evaluated with different forecasting approaches.
          </p>
        </div>

        <div class="impact-item">
          <span>03</span>
          <strong>Decision support</strong>
          <p>
            Forecast outputs were translated into operational purchasing signals.
          </p>
        </div>
      </section>

      <section class="content-section">
        <div class="section-label">
          <span>01</span>
          <p>The problem</p>
        </div>

        <div class="section-content">
          <h2>
            Purchasing based on intuition creates
            <span>avoidable risk.</span>
          </h2>

          <p>
            Restaurant demand varies substantially by product, day and sales
            behavior. Applying the same purchasing logic across every item can
            lead to overstock, shortages and unnecessary working capital.
          </p>

          <p>
            The objective was to create a forecasting workflow capable of
            identifying different demand patterns and selecting an appropriate
            model instead of relying on a single forecasting method.
          </p>
        </div>
      </section>

      <section class="content-section dark">
        <div class="section-label">
          <span>02</span>
          <p>The approach</p>
        </div>

        <div class="section-content">
          <h2>
            Not every product behaves
            <span>the same way.</span>
          </h2>

          <p>
            Historical sales were cleaned and structured at product level before
            evaluating multiple forecasting approaches. Products with relatively
            stable demand could be handled differently from products with
            intermittent or more complex behavior.
          </p>

          <p>
            The workflow compared simple statistical baselines with machine
            learning models, using out-of-sample tests to determine which
            approach performed better for each demand pattern.
          </p>
        </div>
      </section>

      <section class="pipeline">
        <div class="section-heading">
          <p class="eyebrow">Forecasting pipeline</p>
          <h2>From transactions to purchasing signals.</h2>
        </div>

        <div class="pipeline-flow">
          <div class="pipeline-card">
            <span>01</span>
            <h3>Historical Sales</h3>
            <p>
              Transaction-level demand grouped and normalized by product.
            </p>
          </div>

          <div class="connector">→</div>

          <div class="pipeline-card">
            <span>02</span>
            <Icon name="simple-icons:pandas" />
            <h3>Data Preparation</h3>
            <p>
              Cleaning, product normalization and time-series construction.
            </p>
          </div>

          <div class="connector">→</div>

          <div class="pipeline-card">
            <span>03</span>
            <Icon name="simple-icons:scikitlearn" />
            <h3>Model Selection</h3>
            <p>
              Baselines and ML models evaluated according to demand behavior.
            </p>
          </div>

          <div class="connector">→</div>

          <div class="pipeline-card">
            <span>04</span>
            <h3>Purchasing Signal</h3>
            <p>
              Forecast results translated into actionable operational recommendations.
            </p>
          </div>
        </div>
      </section>

      <section class="models">
        <div class="section-heading">
          <p class="eyebrow">Methodology</p>
          <h2>Different models for different demand patterns.</h2>
        </div>

        <div class="model-grid">
          <article>
            <span>BASELINE</span>
            <h3>Moving Average</h3>
            <p>
              Simple rolling averages were used as an interpretable benchmark
              for products with relatively stable recent demand.
            </p>
          </article>

          <article>
            <span>MACHINE LEARNING</span>
            <h3>Recursive Random Forest</h3>
            <p>
              Tree-based forecasting was evaluated for products where recent
              behavior and nonlinear patterns provided predictive value.
            </p>
          </article>

          <article>
            <span>INTERMITTENT DEMAND</span>
            <h3>Croston Method</h3>
            <p>
              Intermittent-demand forecasting was evaluated for low-frequency
              products where conventional averages were less reliable.
            </p>
          </article>
        </div>
      </section>

      <section class="content-section">
        <div class="section-label">
          <span>03</span>
          <p>Validation</p>
        </div>

        <div class="section-content">
          <h2>
            A forecast is useful only if it works
            <span>outside the training data.</span>
          </h2>

          <p>
            Models were validated using future periods excluded from model
            fitting. Tests included short one-day forecasting windows as well as
            multi-day evaluation periods to compare how model performance changed
            across different horizons.
          </p>

          <div class="validation-grid">
            <div>
              <span>01</span>
              <strong>1-Day Test</strong>
              <p>
                Short-horizon validation for operational next-day demand.
              </p>
            </div>

            <div>
              <span>02</span>
              <strong>Multi-Day Test</strong>
              <p>
                Extended validation to evaluate forecast stability over several days.
              </p>
            </div>

            <div>
              <span>03</span>
              <strong>WAPE</strong>
              <p>
                Weighted Absolute Percentage Error used to measure aggregate forecast accuracy.
              </p>
            </div>

            <div>
              <span>04</span>
              <strong>Model Evidence</strong>
              <p>
                Each product retained information about the model selected and its forecast.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="technology">
        <p class="eyebrow">Technology</p>

        <div class="tech-grid">
          <div>
            <Icon name="simple-icons:python" />
            <span>Python</span>
          </div>

          <div>
            <Icon name="simple-icons:pandas" />
            <span>Pandas</span>
          </div>

          <div>
            <Icon name="simple-icons:numpy" />
            <span>NumPy</span>
          </div>

          <div>
            <Icon name="simple-icons:scikitlearn" />
            <span>Scikit-learn</span>
          </div>
        </div>
      </section>

      <section class="visual">
        <div>
          <p class="eyebrow">Model output</p>
          <h2>Forecast evaluation preview.</h2>
        </div>

        <div class="forecast-frame">
          <div class="forecast-label">
            <span>FIRST VALIDATION EXPERIMENT</span>
            <span>SEP 1–7 · STORE / POLO</span>
          </div>

          <img
            src="/images/forecast-validation-week1.png"
            alt="Anonymized seven-day demand forecasting validation"
            loading="lazy"
          />

          <div class="forecast-note">
            <strong>18.9% WAPE</strong>
            <p>
              First seven-day validation experiment comparing forecasted
              product demand against observed in-store demand.
            </p>
          </div>
        </div>
      </section>

      <section class="next">
        <p>Next case study</p>

        <a href="/">
          Operations Management<br />
          System →
        </a>
      </section>
    </main>

    <footer>
      <span>© 2026 Alfonso Palma</span>
      <a href="/">Back to portfolio ↑</a>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #F7F7F5;
    color: #111111;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  :global(a) {
    color: inherit;
  }

  .navbar,
  .hero,
  .impact,
  .content-section,
  .pipeline,
  .models,
  .technology,
  .visual,
  .next,
  footer {
    width: min(1400px, calc(100% - 64px));
    margin-inline: auto;
  }

  .navbar {
    height: 92px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #d4d3cd;
  }

  .logo {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.06em;
    text-decoration: none;
  }

  .back {
    font-size: 13px;
    text-decoration: none;
  }

  .hero {
    padding: 110px 0 120px;
  }

  .eyebrow {
    margin: 0 0 30px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6B6B66;
  }

  .hero h1 {
    margin: 0;
    max-width: 1300px;
    font-size: clamp(62px, 8.5vw, 135px);
    line-height: 0.87;
    letter-spacing: -0.075em;
    font-weight: 500;
  }

  .hero h1 span,
  .section-content h2 span {
    color: #8A7F6A;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
    margin-top: 90px;
  }

  .intro {
    max-width: 650px;
    margin: 0;
    font-size: 24px;
    line-height: 1.5;
    color: #6B6B66;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .meta div {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding-top: 14px;
    border-top: 1px solid #d4d3cd;
  }

  .meta span {
    font-size: 9px;
    letter-spacing: 0.12em;
    color: #6B6B66;
  }

  .meta strong {
    font-size: 13px;
    font-weight: 500;
  }

  .impact {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid #c9c8c1;
    border-bottom: 1px solid #c9c8c1;
  }

  .impact-item {
    padding: 45px 34px;
  }

  .impact-item + .impact-item {
    border-left: 1px solid #c9c8c1;
  }

  .impact-item > span {
    font-size: 10px;
    color: #6B6B66;
  }

  .impact-item strong {
    display: block;
    margin: 50px 0 14px;
    font-size: clamp(34px, 4vw, 58px);
    letter-spacing: -0.05em;
    font-weight: 500;
  }

  .impact-item p {
    max-width: 360px;
    margin: 0;
    line-height: 1.6;
    color: #6B6B66;
  }

  .content-section {
    display: grid;
    grid-template-columns: 0.35fr 1fr;
    gap: 100px;
    padding: 140px 0;
  }

  .section-label {
    display: flex;
    gap: 18px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #6B6B66;
  }

  .section-label p {
    margin: 0;
  }

  .section-content {
    max-width: 920px;
  }

  .section-content h2 {
    margin: 0 0 60px;
    font-size: clamp(48px, 6vw, 90px);
    line-height: 0.98;
    letter-spacing: -0.065em;
    font-weight: 500;
  }

  .section-content > p {
    max-width: 720px;
    margin: 0 0 28px;
    font-size: 19px;
    line-height: 1.7;
    color: #6B6B66;
  }

  .dark {
    width: 100%;
    max-width: none;
    padding-inline: max(32px, calc((100vw - 1400px) / 2));
    background: #111111;
    color: #F7F7F5;
  }

  .dark .section-label,
  .dark .section-content > p {
    color: #a4a39c;
  }

  .pipeline,
  .models {
    padding: 140px 0;
  }

  .section-heading h2,
  .visual h2 {
    margin: 0;
    max-width: 1000px;
    font-size: clamp(48px, 6vw, 90px);
    line-height: 1;
    letter-spacing: -0.065em;
    font-weight: 500;
  }

  .pipeline-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    gap: 20px;
    align-items: center;
    margin-top: 80px;
  }

  .pipeline-card {
    min-height: 310px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    border: 1px solid #c9c8c1;
  }

  .pipeline-card > span {
    font-size: 10px;
    color: #6B6B66;
  }

  .pipeline-card :global(svg) {
    width: 28px;
    height: 28px;
    margin-top: auto;
  }

  .pipeline-card h3 {
    margin: auto 0 12px;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .pipeline-card p {
    margin: 0;
    line-height: 1.5;
    color: #6B6B66;
    font-size: 13px;
  }

  .connector {
    color: #8A7F6A;
    font-size: 22px;
  }

  .models {
    border-top: 1px solid #c9c8c1;
  }

  .model-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 80px;
    border-top: 1px solid #c9c8c1;
    border-bottom: 1px solid #c9c8c1;
  }

  .model-grid article {
    min-height: 370px;
    padding: 32px;
    display: flex;
    flex-direction: column;
  }

  .model-grid article + article {
    border-left: 1px solid #c9c8c1;
  }

  .model-grid span {
    font-size: 9px;
    letter-spacing: 0.12em;
    color: #8A7F6A;
  }

  .model-grid h3 {
    margin: auto 0 18px;
    font-size: 35px;
    line-height: 1;
    letter-spacing: -0.045em;
    font-weight: 500;
  }

  .model-grid p {
    margin: 0;
    line-height: 1.65;
    color: #6B6B66;
  }

  .validation-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-top: 75px;
    border-top: 1px solid #c9c8c1;
  }

  .validation-grid div {
    min-height: 220px;
    padding: 28px 28px 28px 0;
    border-bottom: 1px solid #c9c8c1;
  }

  .validation-grid div:nth-child(odd) {
    border-right: 1px solid #c9c8c1;
  }

  .validation-grid div:nth-child(even) {
    padding-left: 28px;
  }

  .validation-grid span {
    font-size: 10px;
    color: #6B6B66;
  }

  .validation-grid strong {
    display: block;
    margin: 45px 0 12px;
    font-size: 22px;
    font-weight: 500;
  }

  .validation-grid p {
    max-width: 390px;
    margin: 0;
    line-height: 1.6;
    color: #6B6B66;
  }

  .technology {
    padding: 120px 0;
    border-top: 1px solid #c9c8c1;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 50px;
    border-top: 1px solid #c9c8c1;
    border-bottom: 1px solid #c9c8c1;
  }

  .tech-grid > div {
    min-height: 180px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .tech-grid > div + div {
    border-left: 1px solid #c9c8c1;
  }

  .tech-grid :global(svg) {
    width: 26px;
    height: 26px;
  }

  .tech-grid span {
    font-size: 14px;
    font-weight: 500;
  }

  .visual {
    padding: 120px 0 140px;
  }

  .forecast-frame {
    width: min(100%, 960px);
    margin: 70px auto 0;
    padding: 20px;
    background: #111111;
    border-radius: 4px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.12);
  }

  .forecast-label {
    display: flex;
    justify-content: space-between;
    padding: 4px 2px 18px;
    font-size: 9px;
    letter-spacing: 0.14em;
    color: #8A7F6A;
  }

  .forecast-frame img {
    display: block;
    width: 100%;
    max-width: 900px;
    height: auto;
    margin: 0 auto;
    object-fit: contain;
    border-radius: 2px;
  }

  .forecast-note {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 30px;
    padding: 24px 4px 6px;
    color: #F7F7F5;
  }

  .forecast-note strong {
    font-size: 22px;
    font-weight: 500;
  }

  .forecast-note p {
    max-width: 620px;
    margin: 0;
    line-height: 1.6;
    color: #9b9a93;
  }

  .next {
    padding: 120px 0;
    border-top: 1px solid #c9c8c1;
  }

  .next p {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #6B6B66;
  }

  .next a {
    display: inline-block;
    margin-top: 30px;
    font-size: clamp(45px, 6vw, 88px);
    line-height: 0.98;
    letter-spacing: -0.06em;
    text-decoration: none;
  }

  footer {
    padding: 28px 0;
    display: flex;
    justify-content: space-between;
    border-top: 1px solid #c9c8c1;
    font-size: 11px;
    color: #6B6B66;
  }

  footer a {
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .navbar,
    .hero,
    .impact,
    .content-section,
    .pipeline,
    .models,
    .technology,
    .visual,
    .next,
    footer {
      width: calc(100% - 40px);
    }

    .hero {
      padding: 80px 0;
    }

    .hero-grid,
    .content-section {
      grid-template-columns: 1fr;
      gap: 55px;
    }

    .meta,
    .impact,
    .model-grid,
    .tech-grid,
    .validation-grid {
      grid-template-columns: 1fr;
    }

    .impact-item + .impact-item,
    .model-grid article + article,
    .tech-grid > div + div {
      border-left: none;
      border-top: 1px solid #c9c8c1;
    }

    .pipeline-flow {
      grid-template-columns: 1fr;
    }

    .connector {
      transform: rotate(90deg);
      justify-self: center;
    }

    .dark {
      width: 100%;
      padding-inline: 20px;
    }

    .validation-grid div:nth-child(odd) {
      border-right: none;
    }

    .validation-grid div:nth-child(even) {
      padding-left: 0;
    }

    .forecast-frame {
      padding: 12px;
    }

    .forecast-label {
      gap: 20px;
      font-size: 8px;
    }

    .forecast-note {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
